// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "sqlite"
}

model Settings {
  key   String @id
  value String
}

model Product {
  id             String  @id @default(uuid())
  slug           String  @unique
  title          String
  price          String
  description    String?
  plantCare      String?
  deliveryReturns String?
  deliveryNote   String?
  deliveryPincodes String?
  shippingScope   String? @default("all_india")
  deliveryStates  String?
  replacementInfo String?
  deliveryInfo   String?
  supportInfo    String?
  packagingInfo  String?
  soldLast24Hours Int?
  demoMetrics    Boolean @default(true)
  image          String?
  image2         String?
  type           String?
  rating         Float   @default(0)
  reviews        Int     @default(0)
  adeniumOptions String? // Stored as JSON string
  categoryId     String?
  category       Category? @relation("PrimaryCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  categoryIds    String? // Stored as JSON string array e.g. '["id1","id2"]'
  productCategories ProductCategory[]
  oldPrice       String?
  inStock        Boolean @default(true)
  isPublished    Boolean @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([categoryId])
}

model Category {
  id                String            @id @default(uuid())
  slug              String            @unique
  name              String
  nameKey           String            @unique
  parentId          String?
  parent            Category?         @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children          Category[]        @relation("CategoryHierarchy")
  order             Int               @default(0)
  products          Product[]         @relation("PrimaryCategory")
  productCategories ProductCategory[]
  image             String            @default("")
  isVisible         Boolean           @default(true)
  isVisibleInNav    Boolean           @default(true)
  isVisibleInGrid   Boolean           @default(true)
  isVisibleInShopBy Boolean           @default(true)

  @@index([parentId])
}

model ProductCategory {
  productId  String
  categoryId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
  @@index([productId])
}

model Order {
  id                  String   @id @default(uuid())
  orderNumber         Int?     @unique
  receipt             String   @unique
  checkoutTokenHash   String   @unique
  requestHash         String
  razorpayOrderId     String?  @unique
  razorpayPaymentId   String?  @unique
  status              String   @default("pending")
  fulfillmentStatus   String   @default("New")
  customerName        String
  phone               String
  email               String?
  address             String
  pincode             String
  itemsJson           String
  subtotal            Int
  shipping            Int
  total               Int
  currency            String   @default("INR")
  paymentMode         String
  couponCode          String?
  affiliateId         String?
  affiliate           AffiliateAccount? @relation(fields: [affiliateId], references: [id], onDelete: SetNull)
  paidAt              DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([status, createdAt])
  @@index([phone])
  @@index([affiliateId])
  @@index([couponCode])
}

model AffiliateAccount {
  id             String                     @id @default(uuid())
  name           String
  email          String
  phone          String                     @unique
  passwordHash   String
  youtubeUrl     String?
  instagramUrl   String?
  facebookUrl    String?
  message        String?
  status         String                     @default("pending") // "pending", "approved", "rejected", "banned"
  couponCode     String?                    @unique
  warningMessage String?
  banMessage     String?
  rejectReason   String?
  reviewedAt     DateTime?
  programmes     AffiliateAccountProgramme[]
  orders         Order[]
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  @@index([status, createdAt])
  @@index([phone])
}

model AffiliateProgramme {
  id                String                     @id @default(uuid())
  title             String
  description       String?
  commissionType    String                     @default("percentage") // "percentage" | "fixed"
  commissionValue   Float                      @default(10.0)
  commissionPercent Float                      @default(10.0) // Keep for backward compatibility
  discountType      String                     @default("percentage") // "percentage" | "fixed"
  discountValue     Float                      @default(5.0)
  discountPercent   Float                      @default(5.0) // Keep for backward compatibility
  scopeType         String                     @default("all") // "all" | "category" | "products"
  categoryId        String?
  productIds        String?                    // Stored as JSON array string
  minOrderValue     Int?                       @default(0) // In rupees
  startDate         String?                    // YYYY-MM-DD
  endDate           String?                    // YYYY-MM-DD
  status            String                     @default("active") // "active", "inactive"
  terms             String?
  accounts          AffiliateAccountProgramme[]
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
}

model AffiliateAccountProgramme {
  id          String             @id @default(uuid())
  affiliateId String
  programmeId String
  joinedAt    DateTime           @default(now())
  affiliate   AffiliateAccount   @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  programme   AffiliateProgramme @relation(fields: [programmeId], references: [id], onDelete: Cascade)

  @@unique([affiliateId, programmeId])
  @@index([affiliateId])
  @@index([programmeId])
}

model Customer {
  id           String   @id @default(uuid())
  phone        String   @unique
  passwordHash String
  name         String?
  state        String?
  pincode      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([phone])
}

model SiteVisit {
  id             String @id @default(uuid())
  date           String @unique // YYYY-MM-DD
  count          Int    @default(1)
  uniqueVisitors Int    @default(1)
}

model BlogPost {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  excerpt     String?
  content     String
  coverImage  String?
  category    String?  @default("Plant Care")
  author      String?  @default("SabujKuthi Nursery")
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, createdAt])
  @@index([slug])
}
