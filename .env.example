# SabujKuthi Nursery Environment Configuration

# Admin Authentication
ADMIN_PASSWORD=choose-a-strong-admin-password
ADMIN_SESSION_SECRET=generate-a-long-random-secret

# Database (Default for local is file:./dev.db; Docker uses file:/data/dev.db)
DATABASE_URL=file:./dev.db

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=use-a-separate-long-random-secret

# Site Domain (Set to your public domain when deploying)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# VPS Docker Port (Default: 3005 on host, mapped to 3000 inside container)
APP_PORT=3005

# Cloudflare R2 Image Storage (Optional, for CDN uploads)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=chf-media
R2_PUBLIC_URL=https://pub-ce8688bc6c654bcfb99716f7c9373bcd.r2.dev
